generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                             String                   @id @default(cuid())
  email                          String                   @unique
  emailVerified                  DateTime?
  password                       String
  firstName                      String
  lastName                       String
  major                          String?
  yearOfStudy                    Int?
  interests                      String?
  preferences                    Json?
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  acceptedTerms                  DateTime
  bio                            String?
  displayName                    String?
  isBeingMatched                 Boolean                  @default(true)
  isCupid                        Boolean                  @default(false)
  profilePicture                 String?
  showBioToMatches               Boolean                  @default(true)
  showInterestsToMatches         Boolean                  @default(true)
  showProfilePicToMatches        Boolean                  @default(true)
  age                            Int?
  lastActiveDashboard            String                   @default("match")
  cupidDisplayName               String?
  pointOfContact                 String?
  showPointOfContactToMatches    Boolean                  @default(true)
  dashboardTutorialCompleted     Boolean                  @default(false)
  isAdmin                        Boolean                  @default(false)
  preferredCandidateEmail        String?
  profileTutorialCompleted       Boolean                  @default(false)
  isTestUser                     Boolean                  @default(false)
  cupidPortalTutorialCompleted   Boolean                  @default(false)
  questionnaireTutorialCompleted Boolean                  @default(false)
  needsQuestionnaireUpdate       Boolean                  @default(false)
  campus                         String                   @default("Vancouver")
  okMatchingDifferentCampus      Boolean                  @default(true)
  showFreeResponseToMatches      Boolean                  @default(true)
  accounts                       Account[]
  compatibilityScoresReceived    CompatibilityScore[]     @relation("TargetCompatibilityScores")
  compatibilityScoresGiven       CompatibilityScore[]     @relation("UserCompatibilityScores")
  assignedAsCandidates           CupidAssignment[]        @relation("AssignedCandidates")
  cupidAssignments               CupidAssignment[]        @relation("CupidAssignments")
  cupidProfile                   CupidProfile?
  cupidProfileSummary            CupidProfileSummary?
  matchesReceived                Match[]                  @relation("MatchedUser")
  matchesGiven                   Match[]                  @relation("UserMatches")
  questionnaire                  Questionnaire?
  questionnaireResponse          QuestionnaireResponse?
  questionnaireResponseV2        QuestionnaireResponseV2?
  sessions                       Session[]
  textEmbeddings                 TextEmbedding[]
  uploads                        Upload[]

  @@index([email])
}

model Questionnaire {
  id          String   @id @default(cuid())
  userId      String   @unique
  responses   Json
  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuestionnaireResponse {
  id          String    @id @default(cuid())
  userId      String    @unique
  responses   String
  importance  String?
  isSubmitted Boolean   @default(false)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isSubmitted])
}

model QuestionnaireResponseV2 {
  id                 String    @id @default(cuid())
  userId             String    @unique
  freeResponse1      String?
  freeResponse2      String?
  freeResponse3      String?
  freeResponse4      String?
  freeResponse5      String?
  questionsCompleted Int       @default(0)
  isSubmitted        Boolean   @default(false)
  submittedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  responses          Json      @default("{}")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isSubmitted])
}

model Match {
  id                 String    @id @default(cuid())
  userId             String
  matchedUserId      String
  compatibilityScore Float?
  matchType          String
  cupidId            String?
  batchNumber        Int
  revealedAt         DateTime?
  createdAt          DateTime  @default(now())
  cupidComment       String?
  respondedAt        DateTime?
  status             String    @default("accepted")
  matchedUser        User      @relation("MatchedUser", fields: [matchedUserId], references: [id], onDelete: Cascade)
  user               User      @relation("UserMatches", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchedUserId, batchNumber, matchType])
  @@index([userId, batchNumber])
  @@index([matchedUserId, batchNumber])
}

model Upload {
  id           String   @id @default(cuid())
  userId       String
  cloudinaryId String   @unique
  url          String
  type         String
  fileSize     Int
  mimeType     String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model CupidProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  approved       Boolean  @default(false)
  matchesCreated Int      @default(0)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RateLimit {
  id          String   @id @default(cuid())
  identifier  String
  action      String
  attempts    Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([identifier, action])
  @@index([identifier, action])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model CompatibilityScore {
  id                 String   @id @default(cuid())
  userId             String
  targetUserId       String
  section1Score      Float
  section2Score      Float
  section3Score      Float
  section5Score      Float
  totalScore         Float
  bidirectionalScore Float?
  batchNumber        Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  targetUser         User     @relation("TargetCompatibilityScores", fields: [targetUserId], references: [id], onDelete: Cascade)
  user               User     @relation("UserCompatibilityScores", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId, batchNumber])
  @@index([userId, batchNumber])
  @@index([targetUserId, batchNumber])
  @@index([totalScore])
}

model CupidAssignment {
  id               String    @id @default(cuid())
  cupidUserId      String
  batchNumber      Int
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  candidateId      String
  potentialMatches Json
  selectedMatchId  String?
  selectionReason  String?
  rejectedMatches  Json      @default("[]")
  revealedCount    Int       @default(5)
  candidate        User      @relation("AssignedCandidates", fields: [candidateId], references: [id], onDelete: Cascade)
  cupidUser        User      @relation("CupidAssignments", fields: [cupidUserId], references: [id], onDelete: Cascade)

  @@unique([cupidUserId, candidateId, batchNumber])
  @@index([cupidUserId, batchNumber])
  @@index([candidateId, batchNumber])
  @@index([selectedMatchId])
}

model TextEmbedding {
  id             String   @id @default(cuid())
  userId         String
  questionId     String
  embedding      Json
  embeddingModel String   @default("all-MiniLM-L6-v2")
  textHash       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

model CupidProfileSummary {
  id           String   @id @default(cuid())
  userId       String   @unique
  summary      String
  keyTraits    Json
  lookingFor   String
  aiModel      String   @default("gpt-3.5-turbo")
  responseHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MatchingBatch {
  id                  String    @id @default(cuid())
  batchNumber         Int       @unique
  status              String    @default("pending")
  totalUsers          Int       @default(0)
  totalPairs          Int       @default(0)
  algorithmMatches    Int       @default(0)
  cupidMatches        Int       @default(0)
  scoringStartedAt    DateTime?
  scoringCompletedAt  DateTime?
  matchingStartedAt   DateTime?
  matchingCompletedAt DateTime?
  revealedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model CupidFeedback {
  id       String   @id @default(cuid())
  senderId String
  cupidId  String
  message  String
  sentAt   DateTime @default(now())

  @@unique([senderId, cupidId])
  @@index([senderId])
  @@index([cupidId])
}
